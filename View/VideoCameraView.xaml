<UserControl x:Class="MoodScan.View.VideoCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/" 
             xmlns:mdi="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MoodScan.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" 
              VerticalAlignment="Center" 
              HorizontalAlignment="Center"
              Margin="20">
            <Border BorderBrush="{StaticResource BorderBrushGradient}" 
                    CornerRadius="20" 
                    BorderThickness="0.5" 
                    Background="#CC021127">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <MediaElement x:Name="VideoPlayer"
                                      Grid.Column="0"
                                      Source="{Binding VideoSource}"
                                      ScrubbingEnabled="True"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      MediaOpened="VideoPlayer_MediaOpened"
                                      MediaEnded="VideoPlayer_MediaEnded"
                                      Height="400"
                                      Width="1000"
                                      Stretch="Uniform" 
                                      Margin="10,20,10,10"/>

                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" >
                            <Slider Minimum="0"
                                    Style="{StaticResource SliderStyle}"
                                    Value="{Binding VideoProgress}"
                                    Maximum="100"
                                    Width="680"
                                    Height="25"
                                    IsHitTestVisible="False"
                                    IsMoveToPointEnabled="False"
                                    Margin="0,0,0,0">

                            </Slider>
                            <TextBlock Margin="10,5,0,0"
                                       Foreground="White"
                                       FontFamily="Consolas"/>
                        </StackPanel>

                        <Button Grid.Row="1"
                                Cursor="Hand"
                                Width="50"
                                Height="30"
                                Margin="0,0,0,0"
                                Background="{StaticResource color8}"
                                Command="{Binding TogglePlayPauseCommand}"
                                CommandParameter="{Binding ElementName=VideoPlayer}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" 
                                            BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" 
                                                 Value="True">
                                            <Setter Property="Background" 
                                                    Value="{StaticResource color10}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <fa:ImageAwesome Cursor="Hand"
                                     Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}" 
                                     Height="20"
                                     Foreground="{StaticResource fontColor1}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" 
              HorizontalAlignment="Right" 
              Margin="0,30,50,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Style="{StaticResource startButton}" 
                     Tag="{StaticResource color5}" 
                     Command="{Binding OpenQuitPopupCommand}"
                     Grid.Row="0"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Right"
                     Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="ArrowLeft" 
                                     Width="14" 
                                     Height="14" 
                                     Foreground="White"/>
                    <TextBlock Text="WYJDŹ" 
                               Style="{StaticResource startButtonText}" 
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="1"
                       FontWeight="Bold"
                       Text="{Binding RecordingStatus}"
                       Foreground="{StaticResource fontColor2}"
                       FontFamily="Monserrat"
                       HorizontalAlignment="Right"/>

            <Border Grid.Row="2">
                <Border.Effect>
                    <DropShadowEffect Color="LightBlue"
                                      BlurRadius="20"
                                      Opacity="0.4"/>
                </Border.Effect>
                <Image Source="{Binding CameraImage}" 
                       Width="350">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="-1" />
                    </Image.LayoutTransform>
                </Image>
            </Border>
            <TextBlock Grid.Row="3" 
                       Text="{Binding FaceWarningMessage}" 
                       FontFamily="Monserrat"
                       FontSize="16"
                       Foreground="{StaticResource color1}"
                       FontWeight="Medium"
                       Margin="0,10,0,0"/>

            <TextBlock Grid.Row="4" 
                       Text="{Binding CountdownText}"
                       FontFamily="Consolas"
                       FontWeight="Bold"
                       FontSize="25"
                       Foreground="{StaticResource color3}"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Right"
                       Margin="0,0,0,50"/>
        </Grid>

        <Popup Style="{StaticResource PopupStyle}" 
               IsOpen="{Binding IsQuitPopupOpen}">
            <Border Background="{StaticResource color8}" 
                    Padding="50" 
                    BorderThickness="3"
                    CornerRadius="10">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" 
                                         EndPoint="1,1"
                                         GradientStops="{StaticResource BorderStops}"
                                         MappingMode="RelativeToBoundingBox"/>
                </Border.BorderBrush>
                <StackPanel>
                    <TextBlock Text="Czy na pewno chcesz zakoczyć oglądanie?&#x0a;Wyjście spowoduje zresetowanie obecnej próby." 
                               Style="{StaticResource PopupTextStyle}" />

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource startButton}" 
                                Command="{Binding CloseQuitPopupCommand}"
                                Margin="5" 
                                Tag="{StaticResource color4}">
                            <TextBlock Text="ANULUJ" 
                                       Style="{StaticResource startButtonText}"/>
                        </Button>
                        <Button Style="{StaticResource startButton}" 
                                Command="{Binding QuitCommand}"
                                Margin="5" 
                                Tag="{StaticResource color2}">
                            <TextBlock Text="OK" 
                                       Style="{StaticResource startButtonText}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Background="#AA000000" 
              Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              IsHitTestVisible="{Binding IsOverlayVisible}"
              Panel.ZIndex="999" 
              Grid.Column="0" 
              Grid.ColumnSpan="3">
            <Border Background="{StaticResource color8}" 
                    Padding="50" 
                    BorderThickness="3" 
                    CornerRadius="10" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" 
                                         EndPoint="1,1"
                                         GradientStops="{StaticResource BorderStops}"
                                         MappingMode="RelativeToBoundingBox"/>
                </Border.BorderBrush>
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center" >
                    <TextBlock Text="Koniec badania!" 
                               Style="{StaticResource PopupTextStyle}" />

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource startButton}" 
                                Command="{Binding QuitCommand}"
                                Width="200" 
                                Margin="5" 
                                Tag="{StaticResource color4}">
                            <TextBlock Text="PRZEJDŹ DO MENU"
                                       TextWrapping="Wrap"
                                       FontFamily="Montserrat"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       FontWeight="Medium"/>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
        <Grid Background="#AA000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="1000"
              Grid.Column="0" 
              Grid.ColumnSpan="3">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Orientation="Vertical">

                <ProgressBar IsIndeterminate="True"
                             Width="180" Height="8"
                             Margin="0,0,0,20"
                             Foreground="{StaticResource color5}"/>

                <TextBlock Text="Ładowanie wideo i przygotowanie badania..."
                           Foreground="White"
                           FontSize="16"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
