<UserControl x:Class="MoodScan.View.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MoodScan.View"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:mdi="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:viewModel="clr-namespace:MoodScan.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid x:Name="RootGrid" 
          VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" 
              Margin="0,20,0,0" 
              HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" 
                  HorizontalAlignment="Left">
                <Border>
                    <Border.Effect>
                        <DropShadowEffect Color="LightBlue"
                                          BlurRadius="20"
                                          Opacity="0.4"/>
                    </Border.Effect>
                    <Image Source="{Binding CameraImage}" 
                           Width="450">
                        <Image.LayoutTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Image.LayoutTransform>
                    </Image>
                </Border>
                <Border Width="450" 
                        Height="240" 
                        Visibility="{Binding CameraImage, Converter={StaticResource NullToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect Color="LightBlue"
                                          BlurRadius="20"
                                          Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Rectangle Fill="{StaticResource color10}"/>
                        <mdi:PackIconMaterial Kind="CameraRetakeOutline"
                                              Foreground="{StaticResource color1}"
                                              Width="40"
                                              Height="40"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="1" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Center" 
                  Margin="0,0,0,100">
                <StackPanel>
                    <TextBlock Text="Wybrana kamera:" 
                               Foreground="{StaticResource fontColor2}" 
                               FontFamily="Montserrat" TextWrapping="Wrap"/>
                    <ComboBox Width="200" Height="30" Margin="0,5,0,0" Cursor="Hand"
                              Style="{StaticResource ModernComboBox}"
                              ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                              ItemsSource="{Binding AvailableDevices}" 
                              SelectedIndex="{Binding SelectedDeviceIndex, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="Upewnij się, że&#x00A0;Twoja twarz jest poprawnie wykrywana w&#x00A0;kamerze oraz&#x00A0;zadbaj, aby&#x00A0;podczas badania była widoczna tylko jedna osoba. Twój wizerunek będzie analizowany pod&#x00A0;kątem emocji oraz&#x00A0;nagrywany. Jeśli jesteś gotowy, aby&#x00A0;zacząć ogladanie wideo&#x00A0;-&#x00A0;kliknij przycisk poniżej!" 
                       Foreground="{StaticResource fontColor2}"
                       FontFamily="Montserrat"
                       TextWrapping="Wrap"
                       TextAlignment="Justify"
                       Margin="100,30,100,0"
                       FontSize="14"/>
        </Grid>

        <Button Style="{StaticResource startButton}" 
                Tag="{StaticResource color5}"
                Command="{Binding StartVideoCommand}" 
                Grid.Row="2">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <TextBlock Text="START" 
                           Style="{StaticResource startButtonText}" 
                           Margin="0,0,10,0"/>
                <fa:ImageAwesome Icon="ArrowRight" 
                                 Width="14" 
                                 Height="14" 
                                 Foreground="White"/>
            </StackPanel>
        </Button>

        <Popup Style="{StaticResource PopupStyle}" 
               IsOpen="{Binding IsFacesPopupOpen}">
            <Border Background="{StaticResource color8}" 
                    Padding="50" 
                    BorderThickness="3"
                    CornerRadius="10">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" 
                                         EndPoint="1,1"
                                         GradientStops="{StaticResource BorderStops}"
                                         MappingMode="RelativeToBoundingBox"/>
                </Border.BorderBrush>

                <StackPanel>
                    <TextBlock Text="{Binding FacesMessage}" 
                               Style="{StaticResource PopupTextStyle}" />

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <Button Style="{StaticResource startButton}" 
                                Tag="{StaticResource color5}" 
                                Command="{Binding ClosePopupCommand}">
                            <TextBlock Text="OK" 
                                       Style="{StaticResource startButtonText}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
