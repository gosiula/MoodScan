<UserControl x:Class="MoodScan.View.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:local="clr-namespace:MoodScan.View"
             mc:Ignorable="d">
    <Grid>
        <Grid Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="100">
            <ProgressBar IsIndeterminate="True"
                         Width="120"
                         Height="20"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Foreground="BlueViolet"/>
        </Grid>

        <StackPanel Width="600"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="0,10,0,0">
            <Image Source="/Images/logo.png"
                   Width="90" Height="90"/>

            <TextBlock Text="MoodScan"
                       Foreground="White"
                       FontSize="25"
                       FontWeight="Medium"
                       FontFamily="Montserrat"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Witaj w&#x00A0;aplikacji MoodScan!"
                       Foreground="LightGray"
                       FontSize="16"
                       FontWeight="Medium"
                       FontFamily="Montserrat"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,30,0,0"/>

            <TextBlock Text="Program został stworzony po&#x00A0;to,&#x00A0;aby sprawdzać skuteczność matriałów wideo na&#x00A0;postawie Twoich emocji.
                       Postępuj zgodnie z&#x00A0;poniższymi krokami:"                       
                       Foreground="LightGray"
                       FontSize="11"
                       FontWeight="Medium"
                       FontFamily="Montserrat"
                       TextWrapping="Wrap"
                       TextAlignment="Left"
                       Margin="0,10,0,0"/>

            <TextBlock Foreground="LightGray"
                       FontSize="11"
                       FontWeight="Medium"
                       FontFamily="Montserrat"
                       TextWrapping="Wrap"
                       Margin="10,0,0,0"
                       TextAlignment="Left">
                        <Run/>
                        <LineBreak/>
                        <Run Text="1. Rozpoczynając oglądanie pamiętaj, że&#x00A0;należy dbać o&#x00A0;to,&#x00A0;aby w&#x00A0;kamerze była widoczna jedna osoba z&#x00A0;twarzą skierowaną do&#x00A0;kamery, na&#x00A0;jednolitym tle oraz&#x00A0;w&#x00A0;dobrym oświetleniu, co ma na&#x00A0;celu poprawne wykrywanie Twoich emocji."/>
                        <LineBreak/><Run/><LineBreak/>
                        <Run Text="2. Pobrać pliki z&#x00A0;wynikami możesz w&#x00A0;zakładce „Pobierz wyniki”."/>
            </TextBlock>

            <TextBlock Text="Kliknij przycisk poniżej, aby rozpocząć!"
                       Foreground="LightGray"
                       FontSize="12"
                       FontWeight="Medium"
                       FontFamily="Montserrat"
                       TextWrapping="Wrap"
                       TextAlignment="Justify"
                       Margin="0,15,0,0"/>

            <Button Style="{StaticResource startButton}" 
                    Tag="{StaticResource color5}" 
                    Grid.Column="1"
                    Margin="0,50,0,30"
                    Command="{Binding StartCommand}">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <TextBlock Text="START" 
                               Style="{StaticResource startButtonText}" 
                               Margin="0,0,10,0"/>
                    <fa:ImageAwesome Icon="ArrowRight" 
                                     Width="14" 
                                     Height="14" 
                                     Foreground="White"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
