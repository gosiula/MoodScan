<Application x:Class="MoodScan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MoodScan"
             xmlns:converters="clr-namespace:MoodScan.Converters"
             xmlns:viewModel="clr-namespace:MoodScan.ViewModel"
             xmlns:view="clr-namespace:MoodScan.View"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Montserrat"/>
            </Style>

            <Style TargetType="{x:Type Label}">
                <Setter Property="FontFamily" Value="Montserrat"/>
            </Style>

            <Style TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="Montserrat"/>
            </Style>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="FontFamily" Value="Montserrat"/>
            </Style>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
            <converters:BoolToScrollBarConverter x:Key="BoolToScrollBarConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:PlayPauseConverter x:Key="PlayPauseConverter"/>

            <DataTemplate DataType="{x:Type viewModel:StartViewModel}">
                <view:StartView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:CameraViewModel}">
                <view:CameraView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:VideoCameraViewModel}">
                <view:VideoCameraView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:DownloadViewModel}">
                <view:DownloadView/>
            </DataTemplate>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/UIColors.xaml"/>
                <ResourceDictionary Source="/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/PopupStyles.xaml"/>
                <ResourceDictionary Source="/Styles/SliderStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
